# Image registry. Options:
# ghcr.io/qvarkk             — GitHub Container Registry (may be slow/blocked in Russia)
# registry.gitlab.com/qvarkk — GitLab Container Registry (more stable in Russia)
REGISTRY=ghcr.io/qvarkk

# Set to false in production
DEBUG=false

API_PORT=6767

# Port the frontend is exposed on. Change if running behind a reverse proxy
FRONTEND_PORT=80

# Port Garage S3 API is exposed on. Must match the port in AWS_PUBLIC_ENDPOINT_URL
GARAGE_S3_PORT=3900

# Comma-separated list of allowed origins for CORS. Set to your frontend's public URL
# Example: API_CORS_ORIGINS=http://myserver.com,https://myserver.com
API_CORS_ORIGINS=http://localhost

DB_HOST="pg"
DB_PORT=5432
DB_DATABASE="kvault"
DB_USERNAME="postgres"
# Change this to a strong password
DB_PASSWORD="postgres"

REDIS_HOST="redis"
REDIS_PORT=6379
# Change these to strong credentials
REDIS_USER="redis"
REDIS_PASSWORD="redis"
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

CACHE_ENABLED=true
CACHE_ITEMS_TTL=5m
CACHE_FILES_TTL=10m
CACHE_TAGS_TTL=15m
CACHE_STOPWORDS_TTL=30m

AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"
AWS_REGION="garage"
# IMPORTANT: don't change this if you're using garage
AWS_ENDPOINT_URL="http://garage:3900"
AWS_S3_BUCKET="kvault-bucket"
AWS_URL_EXPIRATION=60s
AWS_VIEW_URL_EXPIRATION=24h
# IMPORTANT: set this to your server's public IP or domain + GARAGE_S3_PORT
# This URL is embedded in presigned file links sent to users' browsers
# Example: AWS_PUBLIC_ENDPOINT_URL=http://myserver.com:3900
AWS_PUBLIC_ENDPOINT_URL="http://localhost:3900"

WORKER_CONCURRENT_TASKS=10