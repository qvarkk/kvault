# Ознакомьтесь с разделом "Справочник переменных .env" в HOSTING.md
# Перед тем как изменять переменные

# ============================================================
# Deployment
# ============================================================
KVAULT_VERSION=release/v1.0.0
# KVAULT_REPO=https://gitverse.ru/qvarkk/kvault.git

# ============================================================
# API
# ============================================================
DEBUG=false
API_PORT=6767
FRONTEND_PORT=80
GARAGE_S3_PORT=3900
API_CORS_ORIGINS=http://localhost

# ============================================================
# Database (PostgreSQL)
# ============================================================
DB_HOST="pg"
DB_PORT=5432
DB_DATABASE="kvault"
DB_USERNAME="postgres"
DB_PASSWORD="postgres"

# ============================================================
# Redis
# ============================================================
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_USER="redis"
REDIS_PASSWORD="redis"
REDIS_QUEUE_DB=0
REDIS_CACHE_DB=1

# ============================================================
# Cache
# ============================================================
CACHE_ENABLED=true
CACHE_ITEMS_TTL=5m
CACHE_FILES_TTL=10m
CACHE_TAGS_TTL=15m
CACHE_STOPWORDS_TTL=30m

# ============================================================
# Storage (Garage / S3)
# ============================================================
AWS_ACCESS_KEY_ID="YOUR_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET_KEY"
AWS_REGION="garage"
AWS_ENDPOINT_URL="http://garage:3900"
AWS_S3_BUCKET="kvault-bucket"
AWS_URL_EXPIRATION=60s
AWS_VIEW_URL_EXPIRATION=24h
AWS_PUBLIC_ENDPOINT_URL="http://localhost:3900"

# ============================================================
# Worker
# ============================================================
WORKER_CONCURRENT_TASKS=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_TIMEOUT=5m

# ============================================================
# Auth
# ============================================================
AUTH_API_KEY_TTL=720h
